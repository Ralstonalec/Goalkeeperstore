<section
  id="{{ section.settings.anchor | default: section.id | handleize }}"
  class="a3-section{% if section.settings.surface %} a3-section--surface{% endif %}"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="a3-wrap a3-faq">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="a3-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="a3-muted">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="a3-acc">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question | escape }}</summary>
          <div class="a3-acc__body">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.settings.schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .a3-faq { display: grid; gap: 3.2rem; }
  .a3-faq h2 { margin: 0 0 1.2rem; font-size: clamp(3.2rem, 2.2rem + 2.4vw, 5.2rem); }
  @media screen and (min-width: 990px) {
    .a3-faq { grid-template-columns: 1fr 1.6fr; gap: 8rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK FAQ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight answers" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Output FAQ structured data (SEO)", "default": true, "info": "Only enable on one FAQ section per page." },
    { "type": "checkbox", "id": "surface", "label": "Raised background", "default": false },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Question?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Answer.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "A3GK FAQ" }]
}
{% endschema %}
