{%- comment -%}
  "You told us. We changed it." — a real changelog driven by customer feedback.
  Entries are blocks. With none, an honest placeholder shows instead of fake examples.
{%- endcomment -%}
{%- liquid
  assign max = section.settings.limit
  assign shown = 0
-%}
<section
  class="a3-section a3-tone--{{ section.settings.tone }}"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
  aria-labelledby="a3-fb-{{ section.id }}"
>
  <div class="a3-wrap">
    <div class="a3-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="a3-eyebrow a3-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="a3-fb-{{ section.id }}" class="a3-reveal" style="--a3-i: 1">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="a3-reveal" style="--a3-i: 2">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ol class="a3-log" role="list">
        {%- for block in section.blocks -%}
          {%- if max == 0 or shown < max -%}
            {%- assign shown = shown | plus: 1 -%}
            <li class="a3-log__item a3-reveal" style="--a3-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
              <div class="a3-log__meta">
                {%- if block.settings.date != blank -%}<span>{{ block.settings.date | escape }}</span>{%- endif -%}
                {%- if block.settings.area != blank -%}<span class="a3-badge">{{ block.settings.area | escape }}</span>{%- endif -%}
              </div>
              <div class="a3-log__said">
                <h3 class="a3-small">You told us</h3>
                <p>{{ block.settings.said | escape }}</p>
              </div>
              <div class="a3-log__did">
                <h3 class="a3-small">We changed</h3>
                <p>{{ block.settings.did | escape }}</p>
              </div>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ol>
    {%- else -%}
      <div class="a3-log__empty a3-reveal">
        <div class="a3-lede">{{ section.settings.empty_text }}</div>
        <ol class="a3-log__how" role="list">
          <li><span>01</span><strong>You tell us</strong><p>After delivery we ask short questions: did it fit, did it work, what would you change.</p></li>
          <li><span>02</span><strong>We change it</strong><p>A product, a size, a page, a process. If it's worth fixing, we fix it.</p></li>
          <li><span>03</span><strong>It's logged here</strong><p>What you said, what we did, and the date. Every time.</p></li>
        </ol>
      </div>
    {%- endif -%}

    <div class="a3-log__cta a3-reveal">
      {%- if section.settings.cta_label != blank -%}
        <a class="a3-btn a3-btn--ghost" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
      {%- if section.settings.all_label != blank and section.blocks.size > 0 -%}
        <a class="a3-link" href="{{ section.settings.all_link | default: '#' }}">{{ section.settings.all_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .a3-log { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--a3-line); }
  .a3-log__item {
    display: grid;
    gap: 1.6rem;
    padding: 2.8rem 0;
    border-bottom: 1px solid var(--a3-line);
  }
  .a3-log__meta { display: flex; gap: 1.2rem; align-items: center; color: var(--a3-muted); font-size: 1.4rem; }
  .a3-log h3 { margin: 0 0 0.6rem; font-weight: 500; font-size: 1.35rem; }
  .a3-log p { margin: 0; line-height: 1.55; }
  .a3-log__did p { color: var(--a3-text); }
  .a3-log__did h3 { color: var(--a3-accent-text); }
  .a3-log__empty { padding: 3.2rem 0; border-top: 1px solid var(--a3-line); border-bottom: 1px solid var(--a3-line); }
  .a3-log__how { list-style: none; margin: 3.2rem 0 0; padding: 0; display: grid; gap: 1.2rem; }
  .a3-log__how li { padding: 2.4rem; border: 1px solid var(--a3-line); border-radius: calc(var(--a3-radius, 4px) * 2); background: color-mix(in srgb, var(--a3-text) 3%, transparent); }
  .a3-log__how span { display: block; margin-bottom: 1.6rem; font-size: 1.1rem; font-weight: 600; letter-spacing: 0.16em; color: var(--a3-accent-text); }
  .a3-log__how strong { display: block; font-size: 2rem; letter-spacing: -0.02em; }
  .a3-log__how p { margin: 0.8rem 0 0; color: var(--a3-muted); }
  @media screen and (min-width: 750px) { .a3-log__how { grid-template-columns: repeat(3, 1fr); } }
  .a3-log__cta { display: flex; flex-wrap: wrap; gap: 2.4rem; align-items: center; margin-top: 3.2rem; }

  @media screen and (min-width: 990px) {
    .a3-log__item { grid-template-columns: 18rem 1fr 1fr; gap: 4rem; }
    .a3-log__meta { flex-direction: column; align-items: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK you told us",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What keepers told us, and what we changed" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>Every change listed here started with a keeper telling us something.</p>" },
    {
      "type": "richtext",
      "id": "empty_text",
      "label": "Empty state (no entries yet)",
      "default": "<p>Nothing yet. We haven't launched. After your first order arrives we'll ask a few short questions: did it fit, did it work, what would you change. The first change that comes out of that will be listed here, with the date.</p>"
    },
    { "type": "range", "id": "limit", "label": "Max entries shown (0 = all)", "min": 0, "max": 12, "step": 1, "default": 3 },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Tell us something" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "text", "id": "all_label", "label": "See-all link label", "default": "Every change we've made" },
    { "type": "url", "id": "all_link", "label": "See-all link" },
    { "type": "select", "id": "tone", "label": "Background", "options": [{ "value": "ink", "label": "Dark" }, { "value": "raised", "label": "Dark, raised" }, { "value": "paper", "label": "Light" }], "default": "ink" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "entry",
      "name": "Change",
      "settings": [
        { "type": "paragraph", "content": "Only add real changes that came from real feedback. Newest first." },
        { "type": "text", "id": "date", "label": "Date", "info": "e.g. Nov 2026" },
        { "type": "text", "id": "area", "label": "Area", "info": "e.g. Grip spray, Builder, Shipping" },
        { "type": "textarea", "id": "said", "label": "What keepers told us" },
        { "type": "textarea", "id": "did", "label": "What we changed" }
      ]
    }
  ],
  "presets": [{ "name": "A3GK you told us" }]
}
{% endschema %}
