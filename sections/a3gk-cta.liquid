{%- comment -%}
  Closing call to action: the full-bleed band every page ends on, so pages
  finish as strongly as they open. Floodlit pitch lines, big type, a render.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture link_1
    render 'a3gk-href', url: s.button_link
  endcapture
  capture link_2
    render 'a3gk-href', url: s.button_2_link
  endcapture
-%}
<section class="a3-cta" aria-labelledby="a3-cta-{{ section.id }}">
  <div class="a3-cta__art" aria-hidden="true">
    {%- render 'a3gk-lines', uid: section.id -%}
  </div>
  <div class="a3-wrap a3-cta__inner">
    <div class="a3-cta__copy">
      {%- if s.kicker != blank -%}
        <p class="a3-kicker a3-reveal">{{ s.kicker | escape }}</p>
      {%- endif -%}
      <h2 id="a3-cta-{{ section.id }}" class="a3-cta__title a3-display a3-reveal" style="--a3-i: 1">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}
        <div class="a3-lede a3-cta__text a3-reveal" style="--a3-i: 2">{{ s.text }}</div>
      {%- endif -%}
      <div class="a3-cta__ctas a3-reveal" style="--a3-i: 3">
        {%- if s.button_label != blank -%}
          <a class="a3-btn" href="{{ link_1 | strip | default: '#' }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.button_2_label != blank -%}
          <a class="a3-btn a3-btn--ghost" href="{{ link_2 | strip | default: '#' }}">{{ s.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    </div>
    {%- if s.render != 'none' -%}
      <div class="a3-cta__render a3-reveal" style="--a3-i: 2" aria-hidden="true">
        {%- render 'a3gk-render', kind: s.render, uid: section.id, caption: false -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .a3-cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: #0b0c0a;
    color: #eeebe3;
    border-top: 1px solid rgba(238, 235, 227, 0.08);
  }
  .a3-cta__art { position: absolute; inset: 0; z-index: -1; opacity: 0.9; }
  .a3-cta__art .a3-lines { display: block; width: 100%; height: 100%; }
  .a3-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(50% 60% at 75% 60%, rgba(59, 227, 127, 0.12), rgba(59, 227, 127, 0) 70%),
      linear-gradient(90deg, rgba(11, 12, 10, 0.9) 0%, rgba(11, 12, 10, 0.4) 55%, rgba(11, 12, 10, 0.1) 100%);
  }
  .a3-cta__inner {
    display: grid;
    gap: 4rem;
    align-items: center;
    padding-block: clamp(9.6rem, 10vw, 14.4rem);
  }
  .a3-cta__title {
    margin: 0 0 2.4rem;
    font-size: clamp(4.4rem, 2rem + 5vw, 10rem);
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 0.9;
    max-width: 12ch;
    text-wrap: balance;
  }
  .a3-cta__text { color: rgba(238, 235, 227, 0.8); }
  .a3-cta__ctas { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 3.2rem; }
  .a3-cta__render { height: clamp(32rem, 40vw, 56rem); }
  .a3-cta__render .a3-render { background: none; overflow: visible; }
  .a3-cta__render svg { filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.6)); }
  @media screen and (min-width: 990px) {
    .a3-cta__inner { grid-template-columns: 1.2fr 1fr; }
  }
  @media screen and (max-width: 749px) {
    .a3-cta__render { height: 30rem; order: -1; }
    .a3-cta__ctas .a3-btn { flex: 1 1 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK closing CTA",
  "tag": "div",
  "class": "a3gk-cta-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your kit. Your colours." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Design padded keeper kit in 3D: colours, pattern, number, crest and padding. See the price and lead time before you pay.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Design your kit" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Team orders" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    {
      "type": "select",
      "id": "render",
      "label": "Render",
      "options": [
        { "value": "kit", "label": "Jersey" },
        { "value": "shorts", "label": "Shorts" },
        { "value": "spray", "label": "Grip spray" },
        { "value": "bundle", "label": "Care bundle" },
        { "value": "socks", "label": "Socks" },
        { "value": "none", "label": "None" }
      ],
      "default": "kit"
    }
  ],
  "presets": [{ "name": "A3GK closing CTA" }]
}
{% endschema %}
