{%- comment -%}
  Page hero used across every inner page so they share the homepage's
  cinematic opening. Heading falls back to the page / collection / blog /
  article title, so it works on any template.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading = s.heading
  assign fallback_text = blank
  if heading == blank
    if article
      assign heading = article.title
    elsif collection
      assign heading = collection.title
      assign fallback_text = collection.description
    elsif blog
      assign heading = blog.title
    elsif page
      assign heading = page.title
    elsif template.name == '404'
      assign heading = 'Not here.'
    elsif template.name == 'search'
      assign heading = 'Search'
    elsif template.name == 'cart'
      assign heading = 'Your cart'
    else
      assign heading = page_title
    endif
  endif
  assign title_len = heading | size
  assign title_class = ''
  if title_len > 44
    assign title_class = ' a3-phero__title--xl'
  elsif title_len > 24
    assign title_class = ' a3-phero__title--long'
  endif
  assign kicker = s.kicker
  if kicker == blank and article and s.article_meta
    capture kicker
      echo article.published_at | time_tag: format: 'date'
      if article.author != blank
        echo ' · ' | append: article.author
      endif
    endcapture
  endif
  assign text = s.text
  if text == blank
    assign text = fallback_text
  endif
-%}
<section
  class="a3-phero a3-phero--{{ s.size }} a3-phero--art-{{ s.art }}"
  aria-labelledby="a3-phero-{{ section.id }}"
>
  <div class="a3-phero__art" aria-hidden="true">
    {%- case s.art -%}
      {%- when 'scene' -%}
        {%- render 'a3gk-scene', uid: section.id -%}
      {%- when 'lines' -%}
        {%- render 'a3gk-lines', uid: section.id -%}
      {%- when 'render' -%}
        {%- render 'a3gk-lines', uid: section.id -%}
        <div class="a3-phero__render">
          {%- render 'a3gk-render', kind: s.render, uid: section.id, caption: false -%}
        </div>
    {%- endcase -%}
  </div>
  <div class="a3-phero__shade" aria-hidden="true"></div>

  <div class="a3-wrap a3-phero__content">
    {%- if kicker != blank -%}
      <p class="a3-kicker a3-reveal">{{ kicker | strip }}</p>
    {%- endif -%}
    <h1 id="a3-phero-{{ section.id }}" class="a3-phero__title{{ title_class }} a3-display a3-reveal" style="--a3-i: 1">
      {{- heading | escape -}}
    </h1>
    {%- if text != blank -%}
      <div class="a3-lede a3-phero__text a3-reveal" style="--a3-i: 2">{{ text }}</div>
    {%- endif -%}
    {%- if s.button_label != blank or s.button_2_label != blank -%}
      <div class="a3-phero__ctas a3-reveal" style="--a3-i: 3">
        {%- if s.button_label != blank -%}
          <a class="a3-btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label | escape }}</a>
        {%- endif -%}
        {%- if s.button_2_label != blank -%}
          <a class="a3-btn a3-btn--ghost" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_label | escape }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="a3-phero__facts a3-reveal" style="--a3-i: 4" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="a3-phero__fact-n">{{ block.settings.value | escape }}</span>
            <span>{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .a3-phero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: 62svh;
    overflow: hidden;
    isolation: isolate;
    background: #0b0c0a;
    color: #eeebe3;
    border-bottom: 1px solid rgba(238, 235, 227, 0.08);
  }
  .a3-phero--tall { min-height: 84svh; }
  .a3-phero--compact { min-height: 0; }

  .a3-phero__art { position: absolute; inset: 0; z-index: -2; }
  .a3-phero__art .a3-scene,
  .a3-phero__art .a3-lines { display: block; width: 100%; height: 100%; }
  .a3-phero--art-scene .a3-phero__art { opacity: 0.75; }

  .a3-phero__render {
    position: absolute;
    right: max(2rem, 6vw);
    bottom: 0;
    width: min(46vw, 64rem);
    height: 92%;
  }
  .a3-phero__render .a3-render { background: none; overflow: visible; }
  .a3-phero__render svg { filter: drop-shadow(0 40px 60px rgba(0, 0, 0, 0.6)); }

  .a3-phero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(11, 12, 10, 0.85) 0%, rgba(11, 12, 10, 0.4) 50%, rgba(11, 12, 10, 0) 80%),
      linear-gradient(180deg, rgba(11, 12, 10, 0.3) 0%, rgba(11, 12, 10, 0) 40%, rgba(14, 15, 13, 0.9) 100%);
  }

  .a3-phero__content { width: 100%; padding-block: 14rem 7.2rem; }
  .a3-phero--compact .a3-phero__content { padding-block: 9.6rem 4.8rem; }

  .a3-phero__title {
    margin: 0 0 2.4rem;
    font-size: clamp(4.8rem, 2rem + 6vw, 12rem);
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 0.9;
    max-width: 14ch;
    text-wrap: balance;
    text-shadow: 0 10px 60px rgba(0, 0, 0, 0.45);
  }
  .a3-phero__title--long { font-size: clamp(4.4rem, 2rem + 4.6vw, 9.6rem); max-width: 16ch; }
  .a3-phero__title--xl { font-size: clamp(4rem, 2rem + 3.4vw, 7.2rem); max-width: 20ch; }
  .a3-phero--compact .a3-phero__title { font-size: clamp(4rem, 2rem + 4vw, 8rem); }
  @media screen and (min-width: 990px) {
    .a3-phero--art-render .a3-phero__content > * { max-width: min(54%, 76rem); }
    .a3-phero--art-render .a3-phero__title { font-size: clamp(4.4rem, 1.6rem + 4.2vw, 9rem); }
  }
  .a3-phero__text { color: rgba(238, 235, 227, 0.86); }
  .a3-phero__ctas { display: flex; flex-wrap: wrap; gap: 1.2rem; margin-top: 3.2rem; }

  .a3-phero__facts {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 2.4rem;
    max-width: 88rem;
    margin: 5.6rem 0 0;
    padding: 2.4rem 0 0;
    border-top: 1px solid rgba(238, 235, 227, 0.16);
  }
  .a3-phero__facts li { display: grid; gap: 0.4rem; font-size: 1.4rem; color: rgba(238, 235, 227, 0.7); }
  .a3-phero__fact-n { font-size: 2.8rem; font-weight: 700; font-stretch: 118%; letter-spacing: -0.02em; color: #eeebe3; }

  @media screen and (max-width: 749px) {
    .a3-phero { min-height: 56svh; }
    .a3-phero__content { padding-block: 11rem 4.8rem; }
    .a3-phero__render { right: -12vw; width: 80vw; height: 62%; top: 4rem; bottom: auto; opacity: 0.55; }
    .a3-phero__shade { background: linear-gradient(180deg, rgba(11, 12, 10, 0.2) 0%, rgba(11, 12, 10, 0.6) 45%, #0e0f0d 100%); }
    .a3-phero__ctas .a3-btn { flex: 1 1 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK page hero",
  "tag": "div",
  "class": "a3gk-page-hero-section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave blank to use the page, collection, blog or article title." },
    { "type": "richtext", "id": "text", "label": "Intro" },
    {
      "type": "select",
      "id": "art",
      "label": "Background art",
      "options": [
        { "value": "lines", "label": "Pitch lines" },
        { "value": "scene", "label": "Floodlit goal" },
        { "value": "render", "label": "Product render" },
        { "value": "none", "label": "None" }
      ],
      "default": "lines"
    },
    {
      "type": "select",
      "id": "render",
      "label": "Render (when art is Product render)",
      "options": [
        { "value": "kit", "label": "Jersey" },
        { "value": "shorts", "label": "Shorts" },
        { "value": "spray", "label": "Grip spray" },
        { "value": "wash", "label": "Glove wash" },
        { "value": "tape", "label": "Tape" },
        { "value": "socks", "label": "Socks" },
        { "value": "bag", "label": "Bag" },
        { "value": "bundle", "label": "Bundle" }
      ],
      "default": "kit"
    },
    {
      "type": "select",
      "id": "size",
      "label": "Height",
      "options": [
        { "value": "compact", "label": "Compact" },
        { "value": "medium", "label": "Medium" },
        { "value": "tall", "label": "Tall" }
      ],
      "default": "medium"
    },
    { "type": "checkbox", "id": "article_meta", "label": "Show date and author on articles", "default": true },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "16" },
        { "type": "text", "id": "label", "label": "Label", "default": "Patterns" }
      ]
    }
  ],
  "presets": [{ "name": "A3GK page hero" }]
}
{% endschema %}
