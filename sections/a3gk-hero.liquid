{%- liquid
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<style>
  #a3-hero-{{ section.id }} {
    --a3-hero-h: {{ section.settings.height }}svh;
    --a3-overlay: {{ overlay }};
  }
</style>

<section id="a3-hero-{{ section.id }}" class="a3-hero" aria-labelledby="a3-hero-title-{{ section.id }}">
  <div class="a3-hero__media" data-a3-parallax="{% if section.settings.parallax %}0.12{% else %}0{% endif %}">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '2400x'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        src="{{ section.settings.video_url }}"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 2400 }}"
        {% endif %}
      ></video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {%- render 'a3gk-media',
          image: section.settings.image,
          loading: 'eager',
          sizes: '100vw',
          shot: section.settings.shot
        -%}
      </picture>
    {%- else -%}
      {%- render 'a3gk-scene', uid: section.id -%}
    {%- endif -%}
  </div>

  <div class="a3-hero__shade" aria-hidden="true"></div>

  <div class="a3-hero__content a3-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="a3-kicker a3-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 id="a3-hero-title-{{ section.id }}" class="a3-hero__title a3-display" style="--a3-i: 1">
      {{- section.settings.heading -}}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <div class="a3-lede a3-reveal" style="--a3-i: 2">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="a3-hero__ctas a3-reveal" style="--a3-i: 3">
      {%- if section.settings.button_1_label != blank -%}
        <a class="a3-btn" href="{{ section.settings.button_1_link | default: '#' }}">
          {{- section.settings.button_1_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="a3-btn a3-btn--ghost" href="{{ section.settings.button_2_link | default: '#' }}">
          {{- section.settings.button_2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <ul class="a3-hero__proof" role="list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            <span class="a3-hero__proof-n">{{ forloop.index | prepend: '0' }}</span>
            <span>{{ block.settings.text | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .a3-hero {
    position: relative;
    min-height: var(--a3-hero-h, 92svh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--a3-bg);
    color: var(--a3-text);
    isolation: isolate;
  }

  .a3-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    will-change: transform;
  }

  .a3-hero__media img,
  .a3-hero__media video,
  .a3-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .a3-hero__media .a3-shot {
    justify-content: flex-start;
    align-items: flex-end;
    text-align: right;
    /* Extra right padding: the parallax layer is scaled up ~8%. */
    padding: 12rem calc(var(--a3-gutter) + 6vw) 2rem var(--a3-gutter);
  }

  .a3-hero__media .a3-shot__tag { align-self: flex-end; }

  .a3-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgba(8, 9, 8, 0.75) 0%, rgba(8, 9, 8, 0.25) 55%, rgba(8, 9, 8, 0) 100%),
      linear-gradient(180deg, rgba(8, 9, 8, 0.2) 0%, rgba(8, 9, 8, 0) 45%, rgba(14, 15, 13, 0.95) 100%),
      rgba(8, 9, 8, var(--a3-overlay, 0.1));
  }

  .a3-hero__content {
    width: 100%;
    padding-block: 12rem 7rem;
  }

  .a3-hero__title {
    margin: 0 0 3.2rem;
    font-size: clamp(4.8rem, 2rem + 6.2vw, 12rem);
    font-stretch: 125%;
    letter-spacing: -0.035em;
    line-height: 0.9;
    max-width: 11ch;
    text-shadow: 0 10px 60px rgba(0, 0, 0, 0.45);
  }

  .a3-hero__eyebrow { color: #eeebe3; opacity: 0.85; }

  .a3-hero__proof {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.4rem;
    margin: 6.4rem 0 0;
    padding: 2.4rem 0 0;
    border-top: 1px solid rgba(238, 235, 227, 0.16);
    max-width: 96rem;
  }

  .a3-hero__proof li { display: grid; gap: 0.6rem; font-size: 1.5rem; color: rgba(238, 235, 227, 0.78); line-height: 1.4; }
  .a3-hero__proof-n { font-size: 1.1rem; font-weight: 600; font-stretch: 112%; letter-spacing: 0.16em; color: #3be37f; }

  @media screen and (max-width: 749px) {
    .a3-hero__proof { grid-template-columns: 1fr; gap: 1.4rem; margin-top: 4rem; }
    .a3-hero__proof li { grid-template-columns: 3.2rem 1fr; }
  }

  .a3-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 3.2rem;
  }

  @media screen and (max-width: 749px) {
    .a3-hero__media .a3-scene { height: 58%; }
    .a3-hero__shade {
      background: linear-gradient(180deg, rgba(8, 9, 8, 0) 0%, rgba(8, 9, 8, 0.35) 30%, rgba(14, 15, 13, 0.92) 55%, #0e0f0d 70%);
    }
    .a3-hero__content { padding-block: 10rem 4.8rem; }
    .a3-hero__ctas .a3-btn { flex: 1 1 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK hero",
  "tag": "div",
  "class": "a3gk-hero-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (Shopify-hosted)",
      "info": "Short, muted, looping. 8–15 seconds of real keeper footage. Keep under ~8MB."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Or external .mp4 URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero still (also used as video poster)",
      "info": "2400px wide minimum. Keeper mid-dive, low light, strong contrast."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile still (portrait crop)"
    },
    {
      "type": "text",
      "id": "shot",
      "label": "Placeholder shot description",
      "default": "Keeper mid-dive under floodlights, full stretch, ball at fingertips. Wide, dark, slow-shutter feel.",
      "info": "Shown only until a real image or video is added."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small line above heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keeper kit, done properly."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Glove care, tape, grip socks and custom padded kit. Made for keepers, priced to be bought again.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop glove care"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Build your kit"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (% of screen)",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 92
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darkening overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Subtle parallax on scroll",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Proof point",
      "limit": 3,
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Goalkeepers only" }]
    }
  ],
  "presets": [
    {
      "name": "A3GK hero"
    }
  ]
}
{% endschema %}
