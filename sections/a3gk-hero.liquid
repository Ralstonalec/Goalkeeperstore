{%- liquid
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}
<style>
  #a3-hero-{{ section.id }} {
    --a3-hero-h: {{ section.settings.height }}svh;
    --a3-overlay: {{ overlay }};
  }
</style>

<section id="a3-hero-{{ section.id }}" class="a3-hero" aria-labelledby="a3-hero-title-{{ section.id }}">
  <div class="a3-hero__media" data-a3-parallax="{% if section.settings.parallax %}0.12{% else %}0{% endif %}">
    {%- if section.settings.video != blank -%}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          playsinline: true,
          controls: false,
          preload: 'metadata',
          image_size: '2400x'
      }}
    {%- elsif section.settings.video_url != blank -%}
      <video
        src="{{ section.settings.video_url }}"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        {% if section.settings.image != blank %}
          poster="{{ section.settings.image | image_url: width: 2400 }}"
        {% endif %}
      ></video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
          >
        {%- endif -%}
        {%- render 'a3gk-media',
          image: section.settings.image,
          loading: 'eager',
          sizes: '100vw',
          shot: section.settings.shot
        -%}
      </picture>
    {%- else -%}
      {%- render 'a3gk-media', shot: section.settings.shot -%}
    {%- endif -%}
  </div>

  <div class="a3-hero__shade" aria-hidden="true"></div>

  <div class="a3-hero__content a3-wrap">
    {%- if section.settings.eyebrow != blank -%}
      <p class="a3-eyebrow a3-reveal">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h1 id="a3-hero-title-{{ section.id }}" class="a3-hero__title a3-reveal" style="--a3-i: 1">
      {{- section.settings.heading -}}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <div class="a3-lede a3-reveal" style="--a3-i: 2">{{ section.settings.subheading }}</div>
    {%- endif -%}
    <div class="a3-hero__ctas a3-reveal" style="--a3-i: 3">
      {%- if section.settings.button_1_label != blank -%}
        <a class="a3-btn" href="{{ section.settings.button_1_link | default: '#' }}">
          {{- section.settings.button_1_label | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.button_2_label != blank -%}
        <a class="a3-btn a3-btn--ghost" href="{{ section.settings.button_2_link | default: '#' }}">
          {{- section.settings.button_2_label | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .a3-hero {
    position: relative;
    min-height: var(--a3-hero-h, 92svh);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--a3-bg);
    color: var(--a3-text);
    isolation: isolate;
  }

  .a3-hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    will-change: transform;
  }

  .a3-hero__media img,
  .a3-hero__media video,
  .a3-hero__media picture {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .a3-hero__media .a3-shot {
    justify-content: flex-start;
    align-items: flex-end;
    text-align: right;
    padding: 12rem var(--a3-gutter) 2rem;
  }

  .a3-hero__media .a3-shot__tag { align-self: flex-end; }

  .a3-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(11, 13, 12, 0.2) 0%, rgba(11, 13, 12, 0) 35%, rgba(11, 13, 12, 0.92) 100%),
      rgba(11, 13, 12, var(--a3-overlay, 0.3));
  }

  .a3-hero__content {
    width: 100%;
    padding-block: 12rem 7rem;
  }

  .a3-hero__title {
    margin: 0 0 2.4rem;
    font-size: clamp(5.2rem, 3rem + 7vw, 13rem);
    max-width: 14ch;
  }

  .a3-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-top: 3.2rem;
  }

  @media screen and (max-width: 749px) {
    .a3-hero__content { padding-block: 10rem 4.8rem; }
    .a3-hero__ctas .a3-btn { flex: 1 1 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK hero",
  "tag": "div",
  "class": "a3gk-hero-section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Hero video (Shopify-hosted)",
      "info": "Short, muted, looping. 8–15 seconds of real keeper footage. Keep under ~8MB."
    },
    {
      "type": "url",
      "id": "video_url",
      "label": "Or external .mp4 URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero still (also used as video poster)",
      "info": "2400px wide minimum. Keeper mid-dive, low light, strong contrast."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile still (portrait crop)"
    },
    {
      "type": "text",
      "id": "shot",
      "label": "Placeholder shot description",
      "default": "Keeper mid-dive under floodlights, full stretch, ball at fingertips. Wide, dark, slow-shutter feel.",
      "info": "Shown only until a real image or video is added."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A3GK — Goalkeepers only"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keeper kit, done properly."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Glove care, tape, socks and custom padded kit — made for keepers, priced fairly, and only sold if we'd use it ourselves.</p>"
    },
    {
      "type": "text",
      "id": "button_1_label",
      "label": "Primary button label",
      "default": "Shop glove care"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Secondary button label",
      "default": "Build your kit"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Secondary button link"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (% of screen)",
      "min": 60,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 92
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Darkening overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "parallax",
      "label": "Subtle parallax on scroll",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "A3GK hero"
    }
  ]
}
{% endschema %}
