{%- comment -%}
  Numbered steps / tiers / phases. Used for team-order process, volume
  pricing tiers, and the fit roadmap. Tier blocks with no value show
  "Ask us" rather than an invented number.
{%- endcomment -%}
<section
  id="{{ section.settings.anchor | default: section.id | handleize }}"
  class="a3-section a3-tone--{{ section.settings.tone }}"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="a3-wrap">
    <div class="a3-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="a3-eyebrow a3-reveal">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="a3-reveal" style="--a3-i: 1">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.text != blank -%}
        <div class="a3-reveal" style="--a3-i: 2">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ol class="a3-steps" role="list">
      {%- for block in section.blocks -%}
        <li class="a3-item a3-steps__item a3-reveal{% if block.settings.current %} is-current{% endif %}" style="--a3-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="a3-steps__n">{{ block.settings.label | default: forloop.index | escape }}</span>
          <h3>{{ block.settings.title | escape }}</h3>
          {%- if block.type == 'tier' -%}
            <p class="a3-steps__value">{{ block.settings.value | default: 'Ask us' | escape }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <div class="a3-muted">{{ block.settings.text }}</div>
          {%- endif -%}
          {%- if block.settings.current -%}
            <span class="a3-badge a3-badge--live">Live now</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.settings.footnote != blank -%}
      <p class="a3-small a3-steps__foot">{{ section.settings.footnote | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .a3-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
  }
  .a3-steps__item { justify-items: start; align-content: start; }
  .a3-steps__item.is-current { border-top-color: var(--a3-accent-text); }
  .a3-steps__n { font-size: 1.4rem; font-weight: 500; color: var(--a3-muted); }
  .a3-steps__item h3 { font-size: 2.4rem; }
  .a3-steps__value { font-weight: 700; font-stretch: 75%; font-size: 3.6rem; line-height: 1; color: var(--a3-text); }
  .a3-steps__item p, .a3-steps__item .a3-muted p { margin: 0; }
  .a3-steps__foot { margin-top: 2.4rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK steps / tiers",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Anchor" },
    { "type": "text", "id": "eyebrow", "label": "Small line above heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it works" },
    { "type": "richtext", "id": "text", "label": "Intro" },
    { "type": "text", "id": "footnote", "label": "Footnote" },
    { "type": "select", "id": "tone", "label": "Background", "options": [{ "value": "ink", "label": "Dark" }, { "value": "raised", "label": "Dark, raised" }, { "value": "paper", "label": "Light" }], "default": "ink" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "label", "label": "Label (defaults to number)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "current", "label": "Mark as current", "default": false }
      ]
    },
    {
      "type": "tier",
      "name": "Price tier",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Tier" },
        { "type": "text", "id": "title", "label": "Quantity range", "default": "10–19 pieces" },
        { "type": "text", "id": "value", "label": "Price / discount", "info": "Leave blank to show 'Ask us' until pricing is confirmed." },
        { "type": "richtext", "id": "text", "label": "Notes" },
        { "type": "checkbox", "id": "current", "label": "Highlight", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "A3GK steps / tiers" }]
}
{% endschema %}
