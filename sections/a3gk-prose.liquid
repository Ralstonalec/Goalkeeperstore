{%- comment -%}
  Long-form content: guides, lists of guides, anything written as HTML.
  Used by the built-in guide views until the Guides blog exists in admin.
{%- endcomment -%}
<section
  class="a3-section a3-tone--{{ section.settings.tone }}"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="a3-wrap{% if section.settings.narrow %} a3-prose-wrap{% endif %}">
    {%- if section.settings.heading != blank -%}
      <h1 class="a3-prose__title">{{ section.settings.heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="a3-lede a3-prose__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    <div class="a3-prose">{{ section.settings.html }}</div>
  </div>
</section>

{% stylesheet %}
  .a3-prose-wrap { max-width: 80rem; }
  .a3-prose__title { margin: 0 0 2.4rem; font-size: clamp(3.4rem, 2.4rem + 2.4vw, 5.6rem); }
  .a3-prose__intro { margin: 0 0 4.8rem; color: var(--a3-muted); }
  .a3-prose { font-size: 1.75rem; line-height: 1.7; }
  .a3-prose > :first-child { margin-top: 0; }
  .a3-prose h2 { margin: 5.6rem 0 1.6rem; font-size: clamp(2.4rem, 2rem + 1vw, 3.2rem); }
  .a3-prose h3 { margin: 3.2rem 0 1.2rem; font-size: 2.2rem; }
  .a3-prose p, .a3-prose ul, .a3-prose ol { margin: 0 0 1.6rem; }
  .a3-prose li { margin-bottom: 0.8rem; }
  .a3-prose a:not(.a3-item) { color: inherit; text-underline-offset: 0.3em; text-decoration-thickness: 1px; }
  .a3-prose strong { font-weight: 650; }
  .a3-prose blockquote { margin: 2.4rem 0; padding-left: 2rem; border-left: 2px solid var(--a3-accent-text); color: var(--a3-muted); }
  .a3-prose table { width: 100%; border-collapse: collapse; font-size: 1.55rem; margin: 2.4rem 0; display: block; overflow-x: auto; }
  .a3-prose th, .a3-prose td { text-align: left; padding: 1.2rem 1.6rem 1.2rem 0; border-bottom: 1px solid var(--a3-line); vertical-align: top; }
  .a3-prose th { font-weight: 600; color: var(--a3-muted); }
  .a3-prose hr { border: 0; border-top: 1px solid var(--a3-line); margin: 4.8rem 0; }
  .a3-prose .a3-grid { margin-top: 1.6rem; }
  .a3-prose .a3-item { text-decoration: none; }
  .a3-prose .a3-item h3 { margin: 0; }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK long-form text",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "text", "id": "intro", "label": "Intro line" },
    { "type": "html", "id": "html", "label": "Content (HTML)" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow reading width", "default": true },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "ink", "label": "Dark" },
        { "value": "raised", "label": "Dark, raised" },
        { "value": "paper", "label": "Light" }
      ],
      "default": "ink"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [{ "name": "A3GK long-form text" }]
}
{% endschema %}
