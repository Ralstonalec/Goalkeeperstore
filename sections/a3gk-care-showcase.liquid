<section
  class="a3-section a3-tone--{{ section.settings.tone }}"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="a3-wrap">
    <div class="a3-head">
      <h2>{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div>{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="a3-grid a3-care" style="--a3-min: 24rem">
      {%- for block in section.blocks -%}
        {%- assign p = block.settings.product -%}
        <article class="a3-care__item" {{ block.shopify_attributes }}>
          <div class="a3-care__media a3-media a3-reveal">
            {%- if p != blank and p.featured_media != blank -%}
              {%- render 'a3gk-media', image: p.featured_media.preview_image, sizes: '(min-width: 990px) 25vw, 100vw' -%}
            {%- else -%}
              {%- render 'a3gk-media', image: block.settings.image, shot: block.settings.shot, render: block.settings.render, uid: block.id, tone: section.settings.tone -%}
            {%- endif -%}
          </div>

          <div class="a3-item">
            <div class="a3-care__top">
              {%- if p != blank -%}
                <h3><a href="{{ p.url }}" class="a3-care__title">{{ p.title | escape }}</a></h3>
                <span class="a3-care__price">{{ p.price | money }}</span>
              {%- else -%}
                <h3>{{ block.settings.fallback_title | escape }}</h3>
                <span class="a3-badge">Coming soon</span>
              {%- endif -%}
            </div>
            {%- if block.settings.one_liner != blank -%}
              <p class="a3-muted">{{ block.settings.one_liner | escape }}</p>
            {%- endif -%}
            {%- if p != blank -%}
              {%- render 'a3gk-value-compare',
                product: p,
                name: block.settings.benchmark_name,
                price: block.settings.benchmark_price,
                checked: block.settings.benchmark_checked
              -%}
              {%- unless p.available -%}<span class="a3-badge">Coming soon</span>{%- endunless -%}
            {%- elsif request.design_mode -%}
              <p class="a3-setup">Pick a product for this block. Prices only show once a real product is linked.</p>
            {%- endif -%}
          </div>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <p class="a3-care__cta">
        <a class="a3-link" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      </p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .a3-care__item { display: grid; gap: 2rem; align-content: start; }
  .a3-care__media { aspect-ratio: 4 / 5; }
  .a3-care__top { display: flex; justify-content: space-between; align-items: baseline; gap: 1.2rem; }
  .a3-care__title { color: inherit; text-decoration: none; }
  .a3-care__title:hover { text-decoration: underline; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
  .a3-care__price { font-weight: 600; font-variant-numeric: tabular-nums; }
  .a3-care__cta { margin: 5.6rem 0 0; }

  @media screen and (max-width: 749px) {
    .a3-care { grid-template-columns: 1fr 1fr; gap: 3.2rem 1.6rem; }
    .a3-care__media { aspect-ratio: 1; }
    .a3-care__media .a3-shot > span:last-child { display: none; }
    .a3-care__top { flex-direction: column; gap: 0.4rem; }
    .a3-care__item h3 { font-size: 1.8rem; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK care showcase",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Glove care" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Our own wash, grip spray and deodorizer. Tested on match gloves before they go on sale, and priced to be bought every month.</p>"
    },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Care bundles" },
    { "type": "url", "id": "cta_link", "label": "Link" },
    {
      "type": "select",
      "id": "tone",
      "label": "Background",
      "options": [
        { "value": "ink", "label": "Dark" },
        { "value": "raised", "label": "Dark, raised" },
        { "value": "paper", "label": "Light" }
      ],
      "default": "paper"
    },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Care product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "fallback_title", "label": "Title (before product exists)", "default": "Grip spray" },
        { "type": "text", "id": "one_liner", "label": "One-line description" },
        { "type": "image_picker", "id": "image", "label": "Image (before product exists)" },
        { "type": "select", "id": "render", "label": "Concept render (until a photo is added)", "options": [{ "value": "none", "label": "None (photo frame)" }, { "value": "spray", "label": "Grip spray" }, { "value": "wash", "label": "Glove wash" }, { "value": "deo", "label": "Deodorizer" }, { "value": "bundle", "label": "Care bundle" }, { "value": "tape", "label": "Tape" }, { "value": "socks", "label": "Grip sock" }, { "value": "kit", "label": "Custom jersey" }, { "value": "shorts", "label": "Padded shorts" }, { "value": "bag", "label": "Kit bag" }, { "value": "scene", "label": "Floodlit goal" }], "default": "none" },
        { "type": "text", "id": "shot", "label": "Photo brief", "default": "Bottle on wet turf, floodlight rim light, label legible." },
        { "type": "header", "content": "Comparison" },
        { "type": "paragraph", "content": "Leave blank to use the product's a3gk.benchmark_* metafields. No comparison shows unless a name and price are both set." },
        { "type": "text", "id": "benchmark_name", "label": "Big-brand equivalent", "info": "e.g. GloveGlu Grip Spray 120ml" },
        { "type": "text", "id": "benchmark_price", "label": "Their full retail price", "info": "Number only, in your store currency, e.g. 21.00" },
        { "type": "text", "id": "benchmark_checked", "label": "Price checked", "info": "e.g. Sept 2026" }
      ]
    }
  ],
  "presets": [
    {
      "name": "A3GK care showcase",
      "blocks": [
        { "type": "product", "settings": { "fallback_title": "Grip spray", "one_liner": "Brings tired latex back to tacky." } },
        { "type": "product", "settings": { "fallback_title": "Glove wash", "one_liner": "Lifts dirt and sweat without stripping the latex." } },
        { "type": "product", "settings": { "fallback_title": "Deodorizer", "one_liner": "For the bag. You know why." } },
        { "type": "product", "settings": { "fallback_title": "Care bundle", "one_liner": "Wash, spray and deodorizer in one order." } }
      ]
    }
  ]
}
{% endschema %}
