<section
  class="a3-section"
  style="--a3-pad-top: {{ section.settings.padding_top }}px; --a3-pad-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="a3-wrap">
    <div class="a3-head">
      <h2 class="a3-reveal">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="a3-reveal" style="--a3-i: 1">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <ul class="a3-tiles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign link = block.settings.link
          if link == blank and block.settings.collection != blank
            assign link = block.settings.collection.url
          endif
          assign img = block.settings.image
          if img == blank and block.settings.collection != blank
            assign img = block.settings.collection.featured_image
          endif
        -%}
        <li class="a3-tile a3-reveal{% if forloop.first %} a3-tile--lead{% endif %}" style="--a3-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <a class="a3-tile__link" href="{{ link | default: '#' }}">
            <div class="a3-tile__media a3-media">
              {%- render 'a3gk-media', image: img, shot: block.settings.shot, sizes: '(min-width: 990px) 33vw, 100vw' -%}
            </div>
            <div class="a3-tile__body">
              {%- render 'a3gk-status-badge', status: block.settings.status, label: block.settings.status_label -%}
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.note != blank -%}
                <p class="a3-small">{{ block.settings.note | escape }}</p>
              {%- endif -%}
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .a3-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.6rem;
    grid-template-columns: 1fr;
  }

  .a3-tile__link {
    position: relative;
    display: block;
    height: 100%;
    min-height: 32rem;
    color: var(--a3-text);
    text-decoration: none;
    border-radius: var(--a3-radius);
    overflow: hidden;
    isolation: isolate;
  }

  .a3-tile__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 0;
  }

  .a3-tile__media img { transition: transform 1.2s var(--a3-ease); }
  .a3-tile__link:hover .a3-tile__media img { transform: scale(1.05); }

  .a3-tile__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 30%, rgba(11, 13, 12, 0.9) 100%);
  }

  .a3-tile__body {
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.4rem;
    display: grid;
    gap: 0.8rem;
    justify-items: start;
  }

  .a3-tile__body h3 { margin: 0; font-size: clamp(3rem, 2rem + 2vw, 4.4rem); }
  .a3-tile__body p { margin: 0; color: var(--a3-text); opacity: 0.8; }

  .a3-tile__media .a3-shot { justify-content: flex-start; }

  @media screen and (min-width: 750px) {
    .a3-tiles { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (min-width: 990px) {
    .a3-tiles { grid-template-columns: repeat(3, 1fr); grid-auto-rows: 30rem; }
    .a3-tile--lead { grid-row: span 2; }
    /* Six tiles: let the last one run full width instead of sitting alone. */
    .a3-tile--lead:nth-last-child(6) ~ .a3-tile:last-child { grid-column: 1 / -1; }
    .a3-tile__link { min-height: 0; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "A3GK categories",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What we do" },
    { "type": "richtext", "id": "text", "label": "Intro", "default": "<p>A short range on purpose. If it isn't good enough to recommend, it isn't here.</p>" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Category" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link override" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Falls back to the collection image." },
        { "type": "text", "id": "shot", "label": "Placeholder shot description" },
        {
          "type": "select",
          "id": "status",
          "label": "Status",
          "options": [
            { "value": "live", "label": "Available now" },
            { "value": "soon", "label": "Coming soon" },
            { "value": "none", "label": "No badge" }
          ],
          "default": "none",
          "info": "Keep this honest — only 'Available now' when products are actually in stock."
        },
        { "type": "text", "id": "status_label", "label": "Badge text override" },
        { "type": "text", "id": "note", "label": "One-line note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "A3GK categories",
      "blocks": [
        { "type": "category", "settings": { "title": "Glove care", "status": "soon", "note": "Wash, grip spray, deodorizer. Our own." } },
        { "type": "category", "settings": { "title": "Builder", "status": "soon", "note": "Custom padded jerseys, shorts and pants." } },
        { "type": "category", "settings": { "title": "Tape & socks", "status": "soon" } },
        { "type": "category", "settings": { "title": "Protection", "status": "soon" } },
        { "type": "category", "settings": { "title": "Gloves", "status": "none", "note": "Not yet. Here's why." } }
      ]
    }
  ]
}
{% endschema %}
