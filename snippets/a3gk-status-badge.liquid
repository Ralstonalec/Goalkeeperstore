{%- comment -%}
  Accepts: status ('live' | 'soon' | 'none'), label (optional override)
{%- endcomment -%}
{%- case status -%}
  {%- when 'live' -%}
    <span class="a3-badge a3-badge--live">{{ label | default: 'In stock' }}</span>
  {%- when 'soon' -%}
    <span class="a3-badge">{{ label | default: 'Coming soon' }}</span>
{%- endcase -%}
