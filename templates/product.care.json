{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": false
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "tagline": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.a3gk.tagline.value }}",
            "text_style": "subtitle"
          }
        }
      },
      "block_order": [
        "title",
        "tagline",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "details": {
      "type": "a3gk-product-details",
      "blocks": {
        "why": {
          "type": "why",
          "settings": {
            "title": "Why we made this"
          }
        },
        "fit": {
          "type": "fit",
          "settings": {
            "title": "Who it's for"
          }
        },
        "use": {
          "type": "use",
          "settings": {
            "title": "How to use it"
          }
        },
        "specs": {
          "type": "specs",
          "settings": {
            "title": "Specs",
            "size_label": "Size guide",
            "size_link": "shopify://pages/size-guide"
          }
        },
        "value": {
          "type": "value",
          "settings": {
            "title": "What you'd pay elsewhere"
          }
        },
        "lead": {
          "type": "lead_time",
          "settings": {
            "title": "When it'll arrive",
            "default_text": "Ships within the time shown at checkout. Full details on our shipping page.",
            "link_label": "Shipping details",
            "link": "/policies/shipping-policy"
          }
        },
        "reviews": {
          "type": "reviews_note",
          "settings": {
            "title": "Reviews from keepers"
          }
        }
      },
      "block_order": [
        "why",
        "fit",
        "use",
        "specs",
        "value",
        "lead",
        "reviews"
      ],
      "settings": {
        "padding_top": 48,
        "padding_bottom": 80
      }
    },
    "faq": {
      "type": "a3gk-faq",
      "blocks": {
        "q1": {
          "type": "qa",
          "settings": {
            "question": "Will it damage my latex?",
            "answer": "<p>Glove care should clean and restore without drying the latex out. Follow the directions on the label, rinse in cool or lukewarm water, and always air-dry away from radiators and direct sun \u2014 heat does more damage to latex than anything in a bottle.</p>"
          }
        },
        "q2": {
          "type": "qa",
          "settings": {
            "question": "Can I use it on any brand of glove?",
            "answer": "<p>It's made for latex-palm goalkeeper gloves, whoever makes them. If your glove maker's care label says otherwise, follow theirs.</p>"
          }
        },
        "q3": {
          "type": "qa",
          "settings": {
            "question": "How long does a bottle last?",
            "answer": "<p>It depends how often you train. We show a realistic estimate on each product under \"How often\", and you can set a refill reminder from your account so you don't run out before a match.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3"
      ],
      "settings": {
        "eyebrow": "Care questions",
        "heading": "Before you buy",
        "schema": true,
        "padding_top": 48,
        "padding_bottom": 80
      }
    },
    "bundle_cta": {
      "type": "a3gk-statement",
      "blocks": {
        "link": {
          "type": "link",
          "settings": {
            "label": "See care bundles and the savings",
            "url": "shopify://pages/bundles"
          }
        }
      },
      "block_order": [
        "link"
      ],
      "settings": {
        "eyebrow": "Buying more than one?",
        "heading": "Bundles are cheaper \u2014 and we show the maths.",
        "text": "<p>Every bundle lists the individual prices next to the bundle price, so you can check the saving yourself.</p>",
        "layout": "split",
        "surface": true,
        "padding_top": 64,
        "padding_bottom": 64
      }
    }
  },
  "order": [
    "main",
    "details",
    "bundle_cta",
    "faq",
    "related-products"
  ]
}